---
import Card from "../global/Card.astro";
import Socials from "../socials/Socials.astro";
import Greeting from "./Greeting.svelte";
import pfp_new from "../images/pfp_new.webp";
import pfp_light from "../images/pfp_light.webp";
import { Image } from "astro:assets";
---

<div class="w-[90%] md:w-[600px] lg:w-1/2">
	<Card
		shadowColor="rgba(4, 57, 57, 0.5)"
		className="theme-dark-card animate-fadeIn bg-gradient-to-br from-[#101010] to-[#202020]"
	>
		<div id="intro" class="flex h-fit flex-col">
			<div class="w-full px-5 pt-10 pb-2 lg:px-10">
				<div class="flex h-20 flex-row">
					<div class="mr-1 flex w-20 items-center justify-center">
						<Image
							src={pfp_new}
							alt="Ryan"
							width="80"
							height="80"
							class="profile-image-dark max-w-full rounded-full bg-[#505050]"
							loading="eager"
						/>
						<Image
							src={pfp_light}
							alt="Ryan"
							width="80"
							height="80"
							class="profile-image-light hidden max-w-full rounded-full bg-[#505050]"
							loading="eager"
						/>
					</div>
					<div class="ml-2 flex flex-col items-start justify-center">
						<div
							id="name"
							class="animate-gradient text-2xl font-bold"
						>
							Ryan Lee
						</div>
						<div
							class="flex flex-row items-start justify-start gap-3 text-sm"
						>
							<div
								class="flex flex-row items-center justify-start gap-1"
							>
								<svg
									class="size-4"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.5"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z"
									></path>
								</svg>
								<div>Full Stack Developer</div>
							</div>
							<div
								class="flex flex-row items-center justify-start gap-1"
							>
								<svg
									class="size-4"
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.5"
									stroke="currentColor"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
									></path>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
									></path>
								</svg>
								<div>Malaysia</div>
							</div>
						</div>
					</div>
				</div>
				<div id="uwu" class="hidden items-center justify-center">
					<img
						src="/images/RythonDev-UwU-compressed.webp"
						alt="RythonDev"
						width="400"
						height="131.8"
					/>
				</div>
				<div class="mt-5 mb-5 text-2xl font-bold">
					<Greeting client:load />!
				</div>
				<p class="text-left">
					I am a content creator and software developer, building
					software for 100+ content creators, garnering 4,000+
					followers across platforms. I worked as a developer at 3+
					companies in Malaysia and Australia, and looking for my next
					role after graduation.
				</p>
				<div class="mt-8 flex flex-row items-center justify-center">
					<Socials />
				</div>
			</div>
		</div>
	</Card>
</div>

<style>
	:global(html[data-theme="light"]) .profile-image-dark {
		display: none;
	}

	:global(html[data-theme="light"]) .profile-image-light {
		display: block;
	}

	#name {
		background: linear-gradient(
			90deg,
			#72ffff 0%,
			#20ffb8 55%,
			#0096ff 100%
		);

		background-size: 200%;

		background-clip: text;
		-webkit-background-clip: text;

		-webkit-text-fill-color: transparent;
	}
</style>
