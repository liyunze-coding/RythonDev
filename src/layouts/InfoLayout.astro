---
interface Props {
	title: string;
	description: string;
	thumbnail?: string | null;
	metaURL: string;
}

const { title, description, thumbnail, metaURL } = Astro.props;
import MetaTags from "@/components/global/MetaTags.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" /><meta
			name="keywords"
			content="Rython, student, developer, frontend, web developer, streamer, coworking"
		/>
		<meta name="author" content="RythonDev" />
		<meta name="theme-color" content="#2B2D31" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />

		<MetaTags
			title={title}
			description={description}
			thumbnail={thumbnail}
			metaURL={metaURL}
		/>

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
